# Browser client configuration (.env.local / Vercel Environment Variables) — publishable values ONLY
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ==============================================================================
# Server-side ONLY secrets — configure via `supabase secrets set` on Supabase
# Edge Functions. NEVER prefix these with VITE_ or expose them to browser code.
# ==============================================================================
# PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret
# RESEND_API_KEY=re_replace_with_resend_api_key
# RESEND_FROM_EMAIL="HAMLET <bookings@your-verified-domain.example>"
# RESEND_REPLY_TO_EMAIL=support@your-verified-domain.example
# HAMLET_BOOKINGS_EMAIL=operations-inbox@your-domain.example
# HAMLET_APP_URL=https://your-app-domain.example
# HAMLET_INTERNAL_DISPATCH_SECRET=replace_with_32_char_random_secret_for_cron_sweeps

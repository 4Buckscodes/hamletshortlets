# Next.js public browser/server configuration (publishable values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy Vite variables remain temporarily for the old application during migration.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side secrets belong in Supabase Edge Function secrets or secure hosting
# environment variables. NEVER expose them to browser code or commit real values.
# PAYSTACK_SECRET_KEY=...
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL="HAMLET <bookings@your-verified-domain.example>"
# RESEND_REPLY_TO_EMAIL=support@your-domain.example
# HAMLET_BOOKINGS_EMAIL=operations-inbox@your-domain.example
# HAMLET_APP_URL=https://www.hamlet.rest
# HAMLET_INTERNAL_DISPATCH_SECRET=...

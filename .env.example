# ==============================================================================
# HAMLET.REST — Environment Configuration Example (Next.js App Router MVP)
# ==============================================================================
# Safe publishable browser/server configuration:
NEXT_PUBLIC_SITE_URL=https://www.hamlet.rest
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Temporary compatibility aliases for /legacy bridge route (publishable only):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ==============================================================================
# SERVER-ONLY SECRETS (Configure in Supabase Edge Function Secrets — NEVER
# prefix with NEXT_PUBLIC_ or VITE_, and NEVER commit real values)
# ==============================================================================
# PAYSTACK_SECRET_KEY=sk_live_or_test_...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="HAMLET <bookings@hamlet.rest>"
# RESEND_REPLY_TO_EMAIL=support@hamlet.rest
# HAMLET_BOOKINGS_EMAIL=ops@hamlet.rest
# HAMLET_APP_URL=https://hamlet.rest
# HAMLET_INTERNAL_DISPATCH_SECRET=generate-random-32-byte-secret

# ==============================================================================
# GOOGLE OAUTH PROVIDER (Configure in Supabase Dashboard -> Auth -> Providers -> Google;
# for local `supabase start`, optionally export these in your shell and set
# `[auth.external.google].enabled = true` in supabase/config.toml)
# ==============================================================================
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

{
  "expo": {
    "name": "HAMLET",
    "slug": "hamlet",
    "scheme": "hamlet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abundanceabodes.hamlet"
    },
    "android": {
      "package": "com.abundanceabodes.hamlet",
      "adaptiveIcon": {
        "backgroundColor": "#101D2D"
      }
    }
  }
}

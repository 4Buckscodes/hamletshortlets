# Use an isolated Supabase staging project and matching HAMLET preview deployment for development/preview.
# Never point a development or preview build at the production database or live booking API.
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-staging-publishable-key
EXPO_PUBLIC_HAMLET_API_URL=https://your-hamlet-preview-domain.example

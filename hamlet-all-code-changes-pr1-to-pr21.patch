+            ))}
+            {myRewards.length === 0 && (
+              <tr><td colSpan={6} className="td py-10 text-center text-ink-500">No referral activations or rewards recorded yet.</td></tr>
+            )}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  );
+}

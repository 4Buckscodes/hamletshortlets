+export function isQuoteExpired(quoteExpiresAt?: string | null, now = new Date()): boolean {
+  if (!quoteExpiresAt) return false;
+  const ts = new Date(quoteExpiresAt).getTime();
+  return Number.isNaN(ts) || ts <= now.getTime();
+}

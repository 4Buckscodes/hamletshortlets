+
+describe('HAMLET booking lifecycle (PostgreSQL migrations, RLS & RPCs)', () => {
+  let db: PGlite;
+  let adminId: string;
+  let partnerId: string;
+  let otherPartnerId: string;
+  let guestAId: string;
+  let guestBId: string;
+  let approvedPropertyId: string;
